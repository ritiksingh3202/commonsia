# Copy to `.env` or `.env.local` for local dev. Never commit real secrets.

# Neon Postgres — https://console.neon.tech (use pooled connection string for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth — `npx auth secret` for AUTH_SECRET in production.
# Either AUTH_SECRET or NEXTAUTH_SECRET must be set (Vercel: add one of them).

AUTH_SECRET=
# NEXTAUTH_SECRET=

# Canonical site URL (no trailing slash). Must match the URL in the browser (https, www vs non-www).
# Local dev — use this in `.env` / `.env.local`:
AUTH_URL=http://localhost:3000
# Optional but recommended: set to the same value as AUTH_URL so the next-auth client bundle matches the server.
# NEXTAUTH_URL=http://localhost:3000

# Production — set in Vercel/hosting env only (canonical host: www):
# AUTH_URL=https://www.commonsia.com

# Google (sign-in + Calendar) — primary names (tutorials often use these):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fallback if you still use Auth.js-style names: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Fallback: AUTH_LINKEDIN_ID, AUTH_LINKEDIN_SECRET
# LinkedIn app → Products: enable "Sign in with LinkedIn using OpenID Connect"

# --- OAuth consoles: redirect URIs must match AUTH_URL exactly (https, www, path) ---
#
# Google Cloud → APIs & Services → Credentials → your Web client → Authorized redirect URIs.
# Register EVERY URI you use (same client ID is used for sign-in and Google Calendar):
#   {AUTH_URL}/api/auth/callback/google
#   {AUTH_URL}/api/calendar/google/callback
#
# LinkedIn Developers → your app → Auth → Redirect URLs:
#   {AUTH_URL}/api/auth/callback/linkedin
#
# If you see "Error 400: redirect_uri_mismatch", the URI above is missing or AUTH_URL is wrong.
#
# Production debugging (Vercel): set AUTH_DEBUG=1 temporarily, redeploy, check logs, then remove.
# Ensure `prisma migrate deploy` runs (included in `npm run build` for Vercel).

# Optional: IANA timezone passed to Google Calendar event start/end (default Asia/Kolkata).
# DEFAULT_CALENDAR_TIMEZONE=Asia/Kolkata
