# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env & secrets — never commit real credentials (set vars in Vercel + Neon for production)
.env*
!.env.example

# IDE / local tooling (not needed in repo)
.cursor/
.idea/
*.swp
*.swo

# vercel
.vercel

# typescript
*.tsbuildinfo

# database backups — never commit real data to git
/backups
*.dump
*.dump.gz
