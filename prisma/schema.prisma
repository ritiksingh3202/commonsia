// Auth.js models: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  /// Bcrypt hash for email/password sign-in (OAuth users have null)
  passwordHash     String?
  phone            String?
  emailVerified    DateTime?
  image            String?
  /// "student" | "mentor" — set during onboarding
  role             String?
  university       String?
  yearOfStudy      String?
  major            String?
  /// Location (profile setup — dropdowns on mentor/student step 1)
  country          String?
  city             String?
  interests        Json?
  softwareSkills   String?
  otherInterests   String?   @db.Text
  bio              String?   @db.Text
  portfolioUrl     String?
  /// Original filename for uploaded portfolio (PDF/ZIP), optional.
  portfolioFileName   String?
  /// Data URL for uploaded portfolio file (PDF/ZIP). Large; prefer upload API.
  portfolioFileDataUrl String? @db.Text
  /// When true, mentors/students may open the other party's portfolio file or URL.
  portfolioVisibleToOthers Boolean @default(true)
  profileComplete  Boolean   @default(false)
  /// Custom cover image (data URL or HTTPS). OAuth avatar uses `image`.
  bannerImageUrl   String?   @db.Text
  whatsappUrl      String?
  linkedinUrl      String?
  instagramUrl     String?
  /// Mentor onboarding — professional step 1
  mentorTitle              String?
  mentorCompany            String?
  mentorYearsExperience    String?
  mentorExpertise          Json?
  /// Step 2 — what to mentor on; session & mentee prefs
  mentorMentorshipFocus    String?   @db.Text
  mentorAvailabilityPref   String?
  mentorMaxMenteesPref     String?
  mentorCertifications     String?
  /// Step 4 — scheduling (duration, weekly/specific dates, slots, etc.)
  mentorAvailabilityJson   Json?
  mentorOnboardingComplete Boolean   @default(false)
  /// Google Calendar OAuth refresh token (mentor “Connect Calendar” flow)
  googleCalendarRefreshToken String? @db.Text
  /// Set when the user closes their account; row kept for history / FKs. Excluded from public UI and sign-in.
  accountDeletedAt           DateTime?
  accounts         Account[]
  sessions         Session[]
  chatThreadsAsStudent ChatThread[] @relation("ChatStudent")
  chatThreadsAsMentor  ChatThread[] @relation("ChatMentor")
  chatMessages         ChatMessage[]
  mentoringBookingsAsStudent MentoringBooking[] @relation("BookingStudent")
  mentoringBookingsAsMentor  MentoringBooking[] @relation("BookingMentor")
  bookingRequestsAsStudent   BookingRequest[]   @relation("BookingRequestStudent")
  bookingRequestsAsMentor    BookingRequest[]   @relation("BookingRequestMentor")
  sessionReviewsAuthored     SessionReview[]      @relation("SessionReviewStudent")
  sessionReviewsReceived     SessionReview[]      @relation("SessionReviewMentor")
  forumPosts                 ForumPost[]          @relation("ForumPostAuthor")

  /// Speeds up the public mentor directory + every "find by role" query;
  /// also lets the inbound WhatsApp webhook find a mentor by digit-suffix without a full scan.
  @@index([role, mentorOnboardingComplete, accountDeletedAt])
}

/**
 * Public community feed entry, created when the configured admin user posts to the
 * Commonsia WhatsApp number. Author identity is enforced via env COMMUNITY_AUTHOR_USER_ID
 * and a phone-digit match against User.whatsappUrl / User.phone in the webhook.
 */
model ForumPost {
  id                String   @id @default(cuid())
  authorUserId      String
  author            User     @relation("ForumPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  text              String?  @db.Text
  imageUrl          String?  @db.Text
  links             String[] @default([])
  /// Inbound WhatsApp message id (Zixflow/Meta) OR rss:<sourceId>:<itemGuid> for cron-pulled posts. Used for dedupe.
  whatsappMessageId String?  @unique
  /// One of: bachelors, masters, phd, faculty, startup. Null = uncategorized (shown under "All" only).
  category          String?
  /// Display label for the source ("OpportunityDesk", etc.). Null = posted by author directly.
  sourceLabel       String?
  /// Article URL when the post was auto-pulled from an RSS feed; the card title-links here.
  sourceUrl         String?  @db.Text
  postedAt          DateTime @default(now())
  /// Soft-delete from an admin page later without a migration.
  deletedAt         DateTime?

  @@index([deletedAt, postedAt(sort: Desc)])
  @@index([category, deletedAt, postedAt(sort: Desc)])
}

/// Student–mentor session booked via Commonsia (persists even when Google Calendar is not connected).
model MentoringBooking {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  studentId      String
  mentorId       String
  startAt        DateTime
  endAt          DateTime
  title          String?
  googleEventId  String?
  /// Google Meet (or similar) join URL when `conferenceData` was used on insert.
  googleMeetLink String?  @db.Text

  /// Populated when this session row was created from an approved `BookingRequest`.
  bookingRequestId String?          @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)

  /// Set when Zixflow accepted sending the session-confirmed template to the student WhatsApp (profile field).
  whatsappStudentNotifiedAt DateTime?
  /// Set when Zixflow accepted sending the session-confirmed template to the mentor WhatsApp (profile field).
  whatsappMentorNotifiedAt DateTime?

  student User @relation("BookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("BookingMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([studentId, startAt])
  @@index([mentorId])
  @@index([mentorId, endAt])
}

/**
 * Pending mentor approval for a session (student booking UI → WhatsApp **mentorship_session_booking** template).
 * Meta body {{1}}–{{6}} map via `ZIXFLOW_BOOKING_BODY_VARS_ORDER` (default: mentor, student, year, college, profile URL, time).
 * Accept/Decline use signed `GET /api/webhooks/zixflow?token=…`, not raw `bookingId` URLs.
 */
model BookingRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String
  mentorId  String
  /// Session start — first mentor-configured session-length slice inside the availability band the student picked (not the whole band).
  startAt   DateTime
  /// Session end — `startAt` + mentor session duration (same interval shown as WhatsApp template {{6}} when vars use default order).
  endAt     DateTime

  /// "pending" | "awaiting_slot" | "accepted" | "rejected" | "expired"
  status     String   @default("pending")
  decidedAt  DateTime?

  /// SHA-256 hex of the action token (Accept/Reject). Store hash only (never the raw token).
  actionTokenHash String @unique

  /**
   * Same material as `actionTokenHash` pre-image (64-char hex). Server-only: used to sign `/select-slot`
   * catalog links when the mentor taps WhatsApp quick-reply Accept (no token in URL). Cleared when the
   * row leaves `pending` or when Redis `rememberBookingActionRawToken` is used as primary. Supplements
   * Upstash when env is missing in production.
   */
  actionRawTokenOpaque String? @db.Text

  /// When accepted, we create a real Calendar event and store its ids.
  googleEventId  String?
  googleMeetLink String? @db.Text

  /// Optional note/title from student (shown in Calendar description).
  title       String?
  description String? @db.Text

  student User @relation("BookingRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User @relation("BookingRequestMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  mentoringBooking MentoringBooking?

  @@index([mentorId, startAt])
  @@index([studentId, createdAt])
  @@unique([mentorId, startAt, endAt])
}

/// Student ↔ mentor DM thread. `pending` until mentor accepts (message request).
model ChatThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String
  mentorId  String
  status    String   @default("pending")
  /// Set when the mentor accepts the request — used for student-facing “request accepted” notifications.
  mentorAcceptedAt DateTime?

  student  User          @relation("ChatStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor   User          @relation("ChatMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([studentId, mentorId])
  @@index([studentId])
  @@index([mentorId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

/// Review submitted after a mentorship session; home page + mentor public profile.
model SessionReview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentId String
  student   User     @relation("SessionReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)

  /// Mentor `User.id` this review is about (optional for legacy rows).
  mentorId String?
  mentor   User?    @relation("SessionReviewMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  rating  Int
  tags    Json     @default("[]")
  comment String?  @db.Text

  @@index([studentId])
  @@index([mentorId])
  @@index([createdAt(sort: Desc)])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
