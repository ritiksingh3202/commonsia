// Auth.js models: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  /// Bcrypt hash for email/password sign-in (OAuth users have null)
  passwordHash     String?
  phone            String?
  emailVerified    DateTime?
  image            String?
  /// "student" | "mentor" — set during onboarding
  role             String?
  university       String?
  yearOfStudy      String?
  major            String?
  interests        Json?
  softwareSkills   String?
  otherInterests   String?   @db.Text
  bio              String?   @db.Text
  portfolioUrl     String?
  /// Original filename for uploaded portfolio (PDF/ZIP), optional.
  portfolioFileName   String?
  /// Data URL for uploaded portfolio file (PDF/ZIP). Large; prefer upload API.
  portfolioFileDataUrl String? @db.Text
  profileComplete  Boolean   @default(false)
  /// Custom cover image (data URL or HTTPS). OAuth avatar uses `image`.
  bannerImageUrl   String?   @db.Text
  whatsappUrl      String?
  linkedinUrl      String?
  instagramUrl     String?
  /// Mentor onboarding — professional step 1
  mentorTitle              String?
  mentorCompany            String?
  mentorYearsExperience    String?
  mentorExpertise          Json?
  /// Step 2 — what to mentor on; session & mentee prefs
  mentorMentorshipFocus    String?   @db.Text
  mentorAvailabilityPref   String?
  mentorMaxMenteesPref     String?
  mentorCertifications     String?
  /// Step 4 — scheduling (duration, weekly/specific dates, slots, etc.)
  mentorAvailabilityJson   Json?
  mentorOnboardingComplete Boolean   @default(false)
  /// Google Calendar OAuth refresh token (mentor “Connect Calendar” flow)
  googleCalendarRefreshToken String? @db.Text
  accounts         Account[]
  sessions         Session[]
  chatThreadsAsStudent ChatThread[] @relation("ChatStudent")
  chatThreadsAsMentor  ChatThread[] @relation("ChatMentor")
  chatMessages         ChatMessage[]
}

/// Student ↔ mentor DM thread. `pending` until mentor accepts (message request).
model ChatThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentId String
  mentorId  String
  status    String   @default("pending")

  student  User          @relation("ChatStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor   User          @relation("ChatMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([studentId, mentorId])
  @@index([studentId])
  @@index([mentorId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
